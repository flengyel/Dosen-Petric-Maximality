 \title{Maximality of the Do\v{s}en--Petri\'c Boolean Category}
 \author{Florian Lengyel\thanks{Email: \href{mailto:flengyel@gradcenter.cuny.edu}{\texttt{flengyel@gradcenter.cuny.edu}}}}
-\date{November 1, 2026\quad(v17)}
